# The backend's public base URL. Exposed to the browser (NEXT_PUBLIC_*) since
# client components call it directly with credentials: "include".
NEXT_PUBLIC_API_URL="http://localhost:4000"

# MUST be the exact same value as the backend's JWT_ACCESS_SECRET — this app
# only verifies the access-token JWT (for redirect UX), it never signs one.
# Server-only: no NEXT_PUBLIC_ prefix, never sent to the browser.
JWT_ACCESS_SECRET="change-me-to-a-long-random-value"
