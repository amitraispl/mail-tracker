generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id            String   @id @default(cuid())
  name          String
  openToken     String   @unique
  sentCount     Int      @default(0)
  createdAt     DateTime @default(now())
  processedHtml String?

  links  Link[]
  opens  OpenEvent[]
  clicks ClickEvent[]
}

model Link {
  id          String  @id @default(cuid())
  token       String  @unique
  originalUrl String
  label       String?
  campaignId  String

  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clicks   ClickEvent[]

  @@index([campaignId])
}

model OpenEvent {
  id           String   @id @default(cuid())
  campaignId   String
  recipientRef String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model ClickEvent {
  id           String   @id @default(cuid())
  linkId       String
  campaignId   String
  recipientRef String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  link     Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([linkId])
}
