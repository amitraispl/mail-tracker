# MySQL connection string. Aiven (and most managed MySQL hosts) require SSL —
# their dashboard gives you the exact "Service URI" to paste here, e.g.:
#   mysql://USER:PASS@HOST:PORT/DBNAME?ssl-mode=REQUIRED
#
# Using the bundled `mysql` service from the root docker-compose.yml instead
# of a managed host? Point this at that container by service name, no SSL
# needed, and make it match the MARIADB_* values below exactly:
#   DATABASE_URL="mysql://mailtracker:change_me_db_password@mysql:3306/mailtracker"
DATABASE_URL="mysql://USER:PASS@HOST:PORT/DBNAME?ssl-mode=REQUIRED"

# ── Bundled local database (docker-compose's `mysql` service only) ────────────
# These four vars are read by the `mysql` service in the root docker-compose.yml
# to initialize the MariaDB container — the backend app itself never reads
# them directly (it only reads DATABASE_URL above). Not needed at all if
# you're pointing DATABASE_URL at an external managed MySQL host instead.
MARIADB_ROOT_PASSWORD="change_me_root_password"
MARIADB_DATABASE="mailtracker"
MARIADB_USER="mailtracker"
MARIADB_PASSWORD="change_me_db_password"

# Public host recipients' mail clients hit for the pixel/redirect — this is
# now the BACKEND's own public host (not the frontend's). Must be real HTTPS
# in production; http://localhost:4000 only for local dev.
PUBLIC_TRACK_BASE_URL="http://localhost:4000"

# The frontend's origin(s), comma-separated if more than one. Required for
# CORS to allow credentialed (cookie-carrying) requests.
FRONTEND_ORIGIN="http://localhost:3000"

# Random secret used to sign access-token JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-value"

# Empty = host-only cookie (correct for local dev, and for prod when frontend
# and backend are on unrelated domains, e.g. a Vercel frontend + a Render
# backend — auth then relies on SameSite=None + CORS, not a shared cookie
# domain). Only set this if frontend and backend share a parent domain, e.g.:
#   COOKIE_DOMAIN=".illumiasolutions.com"   # app.illumiasolutions.com + api.illumiasolutions.com
COOKIE_DOMAIN=""

PORT=4000
NODE_ENV="development"
