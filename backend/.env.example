# Same Postgres DB the app already used. Use Neon's pooled connection string.
DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

# Public host recipients' mail clients hit for the pixel/redirect — this is
# now the BACKEND's own public host (not the frontend's). Must be real HTTPS
# in production; http://localhost:4000 only for local dev.
PUBLIC_TRACK_BASE_URL="http://localhost:4000"

# The frontend's origin(s), comma-separated if more than one. Required for
# CORS to allow credentialed (cookie-carrying) requests.
FRONTEND_ORIGIN="http://localhost:3000"

# Random secret used to sign access-token JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-value"

# Empty = host-only cookie (correct for local dev on localhost). In
# production, set to the shared parent domain so the cookie is readable
# across both the app and api subdomains, e.g.:
#   COOKIE_DOMAIN=".illumiasolutions.com"
COOKIE_DOMAIN=""

PORT=4000
NODE_ENV="development"
